# Copy this file to .env.local and fill in your Supabase project values.
# Get them from: https://supabase.com/dashboard/project/<your-project>/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# PostHog analytics — get the project key from https://us.posthog.com/project/settings.
# Analytics is a no-op without VITE_POSTHOG_KEY set, so it's safe to leave blank in local dev.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 to enable analytics capture in a LOCAL dev build for testing before launch (normally
# analytics only runs in production). Never set this in a real deploy.
VITE_ANALYTICS_DEV=

# ── Multiplayer WebRTC ICE (STUN/TURN) ────────────────────────────────────────────────────────
# All OPTIONAL. Leave blank to use the built-in free tier (Google STUN + OpenRelay TURN) — this is
# the current $0 default and needs no configuration. Override ONLY when launch analytics
# (multiplayer_ice_connected.used_relay rate) show a paid TURN provider is warranted. Swapping
# providers (Metered / Twilio / Cloudflare / self-hosted coturn) is an env change only, no code
# change. See docs/MULTIPLAYER_RUNBOOK.md.
#
# STUN: comma-separated stun: URLs.
VITE_STUN_URLS=
# TURN, preferred form: a JSON array of RTCIceServer objects (supports multiple providers + rotation).
#   e.g. [{"urls":"turn:relay.example.com:443","username":"user","credential":"pass"}]
VITE_TURN_SERVERS=
# TURN, shorthand for a single provider (used only if VITE_TURN_SERVERS is unset). URLs may be comma-separated.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
