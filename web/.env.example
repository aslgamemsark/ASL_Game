# Copy this file to .env.local and fill in your Supabase project values.
# Get them from: https://supabase.com/dashboard/project/<your-project>/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# PostHog project API key, from https://us.posthog.com/project/settings
VITE_POSTHOG_KEY=your-posthog-project-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com
